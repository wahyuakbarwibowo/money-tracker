<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark theme overrides. Only semantic tokens are overridden; brand
         primary/accent and income/expense status colors stay constant so the
         app keeps its identity in dark mode. -->

    <!-- Surfaces -->
    <color name="background">#121212</color>
    <color name="surface">#1E1E1E</color>
    <color name="card_background">#1E1E1E</color>

    <!-- Text -->
    <color name="text_primary">#ECECEC</color>
    <color name="text_secondary">#B0B0B0</color>
    <color name="text_hint">#7A7A7A</color>

    <!-- UI -->
    <color name="divider">#2C2C2C</color>
    <color name="divider_light">#262626</color>
    <color name="bottom_nav_color">#9E9E9E</color>

    <!-- Slightly brighter primary for contrast on dark surfaces -->
    <color name="primary_light">#1F2A37</color>
</resources>
